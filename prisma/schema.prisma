generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum ClientType {
  MUNICIPALITY
  PRIVATE_OR_BANKRUPTCY
}

enum BillingFrequency {
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum InvoiceStatus {
  TO_ISSUE
  ISSUED
  PAID
  CANCELLED
}

enum ContractKind {
  STORAGE
  MOVEMENTS
}

enum ServiceUnit {
  FIXED
  INTERVENTION
  PAGE
  SHIPMENT
  BOX
}

enum ServiceBillingMode {
  ONE_OFF
  ANNUAL
  USAGE
  STORAGE
}

enum InvoiceType {
  ORDINARY
  SUPPLEMENTARY
  CREDIT_NOTE
}

enum StockMovementType {
  IN
  OUT
}

enum InflationAdjustmentStatus {
  PREVIEW
  CONFIRMED
  CANCELLED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String
  passwordHash         String
  role                 UserRole              @default(ADMIN)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdClients       Client[]              @relation("ClientCreatedBy")
  createdInvoices      Invoice[]             @relation("InvoiceCreatedBy")
  issuedInvoices       Invoice[]             @relation("InvoiceIssuedBy")
  createdContracts     Contract[]            @relation("ContractCreatedBy")
  createdMovements     ServiceMovement[]     @relation("MovementCreatedBy")
  recordedPayments     Payment[]             @relation("PaymentRecordedBy")
  confirmedAdjustments InflationAdjustment[] @relation("InflationConfirmedBy")
}

model Client {
  id                 String              @id @default(cuid())
  name               String
  type               ClientType
  taxCode            String?
  vatNumber          String?
  notes              String?
  boxQuantity        Int
  monthlyPricePerBox Decimal             @db.Decimal(12, 4)
  billingFrequency   BillingFrequency
  registrationDate   DateTime            @db.Date
  determina          String?
  cig                String?
  commitmentAmount   Decimal?            @db.Decimal(12, 2)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String?
  createdBy          User?               @relation("ClientCreatedBy", fields: [createdById], references: [id])
  invoices           Invoice[]
  contracts          Contract[]
  customServices     ServiceDefinition[]
  clientServices     ClientService[]
  stockMovements     StockMovement[]
  serviceMovements   ServiceMovement[]

  @@index([name])
  @@index([type, active])
}

model Invoice {
  id                   String           @id @default(cuid())
  clientId             String
  client               Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId           String?
  contract             Contract?        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractVersionId    String?
  contractVersion      ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: Restrict)
  invoiceType          InvoiceType      @default(ORDINARY)
  periodStart          DateTime         @db.Date
  periodEnd            DateTime         @db.Date
  scheduledDate        DateTime         @db.Date
  billingFrequency     BillingFrequency
  boxQuantitySnapshot  Int
  monthlyPriceSnapshot Decimal          @db.Decimal(12, 4)
  monthsSnapshot       Int
  amount               Decimal          @db.Decimal(12, 2)
  status               InvoiceStatus
  issuedAt             DateTime?
  externalNumber       String?
  externalDate         DateTime?        @db.Date
  idempotencyKey       String?          @unique
  parentInvoiceId      String?
  parentInvoice        Invoice?         @relation("InvoiceCorrections", fields: [parentInvoiceId], references: [id], onDelete: Restrict)
  corrections          Invoice[]        @relation("InvoiceCorrections")
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdById          String?
  createdBy            User?            @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  issuedById           String?
  issuedBy             User?            @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  lines                InvoiceLine[]
  payments             Payment[]

  @@index([status, scheduledDate])
  @@index([clientId, status])
  @@index([contractId, status, scheduledDate])
  @@index([scheduledDate])
}

model Contract {
  id                   String                @id @default(cuid())
  clientId             String
  client               Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  kind                 ContractKind
  name                 String
  startDate            DateTime              @db.Date
  endDate              DateTime?             @db.Date
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdById          String?
  createdBy            User?                 @relation("ContractCreatedBy", fields: [createdById], references: [id])
  versions             ContractVersion[]
  clientServices       ClientService[]
  stockMovements       StockMovement[]
  serviceMovements     ServiceMovement[]
  invoices             Invoice[]
  inflationAdjustments InflationAdjustment[]

  @@index([clientId, kind, active])
  @@index([endDate, active])
}

model ContractVersion {
  id               String    @id @default(cuid())
  contractId       String
  contract         Contract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  versionNumber    Int
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  determina        String?
  cig              String?
  commitmentAmount Decimal?  @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime  @default(now())
  invoices         Invoice[]

  @@unique([contractId, versionNumber])
  @@index([contractId, effectiveFrom, effectiveTo])
}

model ServiceDefinition {
  id             String             @id @default(cuid())
  code           String?
  name           String
  unit           ServiceUnit
  billingMode    ServiceBillingMode
  standard       Boolean            @default(false)
  clientId       String?
  client         Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  clientServices ClientService[]
  invoiceLines   InvoiceLine[]
  movements      ServiceMovement[]

  @@unique([code])
  @@index([clientId, active])
}

model ClientService {
  id                  String            @id @default(cuid())
  clientId            String
  client              Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId          String
  contract            Contract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  serviceDefinitionId String
  serviceDefinition   ServiceDefinition @relation(fields: [serviceDefinitionId], references: [id], onDelete: Restrict)
  billingFrequency    BillingFrequency?
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  prices              PriceVersion[]
  movements           ServiceMovement[]

  @@unique([clientId, contractId, serviceDefinitionId])
  @@index([contractId, active])
}

model PriceVersion {
  id                    String               @id @default(cuid())
  clientServiceId       String
  clientService         ClientService        @relation(fields: [clientServiceId], references: [id], onDelete: Restrict)
  unitPriceVatIncluded  Decimal              @db.Decimal(12, 4)
  effectiveFrom         DateTime             @db.Date
  effectiveTo           DateTime?            @db.Date
  source                String               @default("MANUAL")
  inflationAdjustmentId String?
  inflationAdjustment   InflationAdjustment? @relation(fields: [inflationAdjustmentId], references: [id], onDelete: Restrict)
  createdAt             DateTime             @default(now())

  @@unique([clientServiceId, effectiveFrom])
  @@index([clientServiceId, effectiveFrom, effectiveTo])
}

model StockMovement {
  id                String            @id @default(cuid())
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId        String
  contract          Contract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  type              StockMovementType
  quantity          Int
  occurredOn        DateTime          @db.Date
  reason            String?
  serviceMovementId String?           @unique
  serviceMovement   ServiceMovement?  @relation(fields: [serviceMovementId], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())

  @@index([contractId, occurredOn])
}

model ServiceMovement {
  id                   String            @id @default(cuid())
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId           String
  contract             Contract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  clientServiceId      String
  clientService        ClientService     @relation(fields: [clientServiceId], references: [id], onDelete: Restrict)
  serviceDefinitionId  String
  serviceDefinition    ServiceDefinition @relation(fields: [serviceDefinitionId], references: [id], onDelete: Restrict)
  occurredOn           DateTime          @db.Date
  description          String?
  quantity             Decimal           @db.Decimal(12, 3)
  unitPriceVatIncluded Decimal?          @db.Decimal(12, 4)
  totalVatIncluded     Decimal           @db.Decimal(12, 2)
  permanentStockExit   Boolean           @default(false)
  stockQuantity        Int?
  invoiceLineId        String?
  invoiceLine          InvoiceLine?      @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  stockMovement        StockMovement?
  createdAt            DateTime          @default(now())
  createdById          String?
  createdBy            User?             @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([contractId, occurredOn])
  @@index([clientServiceId, invoiceLineId])
}

model InvoiceLine {
  id                   String             @id @default(cuid())
  invoiceId            String
  invoice              Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceDefinitionId  String?
  serviceDefinition    ServiceDefinition? @relation(fields: [serviceDefinitionId], references: [id], onDelete: Restrict)
  description          String
  quantity             Decimal            @db.Decimal(12, 3)
  unit                 ServiceUnit
  unitPriceVatIncluded Decimal            @db.Decimal(12, 4)
  months               Int?
  periodStart          DateTime?          @db.Date
  periodEnd            DateTime?          @db.Date
  amountVatIncluded    Decimal            @db.Decimal(12, 2)
  createdAt            DateTime           @default(now())
  movements            ServiceMovement[]

  @@index([invoiceId])
  @@index([serviceDefinitionId])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paidAt       DateTime @db.Date
  amount       Decimal  @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now())
  recordedById String?
  recordedBy   User?    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([invoiceId, paidAt])
}

model InflationAdjustment {
  id            String                    @id @default(cuid())
  contractId    String
  contract      Contract                  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  percentage    Decimal                   @db.Decimal(8, 4)
  effectiveFrom DateTime                  @db.Date
  status        InflationAdjustmentStatus @default(PREVIEW)
  createdAt     DateTime                  @default(now())
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?                     @relation("InflationConfirmedBy", fields: [confirmedById], references: [id])
  priceVersions PriceVersion[]

  @@unique([contractId, effectiveFrom])
  @@index([status, effectiveFrom])
}
